{
  "name": "chatgpt-thread-exporter",
  "version": "0.1.0",
  "description": "Local-first CLI for exporting ChatGPT shared-link threads to Markdown.",
  "license": "MIT",
  "private": false,
  "type": "module",
  "bin": {
    "chatgpt-thread-exporter": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./pipeline": {
      "types": "./dist/pipeline.d.ts",
      "import": "./dist/pipeline.js"
    },
    "./pipeline.js": {
      "types": "./dist/pipeline.d.ts",
      "import": "./dist/pipeline.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "npx puppeteer browsers install chrome && node scripts/build.mjs",
    "check": "tsc --noEmit -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "web": "tsx server.ts",
    "web:prod": "node dist/server.js",
    "prepare": "npm run build",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.5.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "express": "^5.2.1",
    "marked": "^18.0.0",
    "puppeteer": "^25.10.0"
  }
}
